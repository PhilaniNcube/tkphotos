# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Payload
PAYLOAD_SECRET=generate-a-long-random-string

# Email (Resend + React Email)
# RESEND_API_KEY is required to send contact-form and Payload auth emails.
RESEND_API_KEY=
# Must be on a domain verified in Resend (use onboarding@resend.dev to test).
EMAIL_FROM_ADDRESS=noreply@tkmedia.co.za
EMAIL_FROM_NAME=TK Media
# Inbox that receives website enquiries (comma-separated for multiple).
CONTACT_TO_EMAIL=hello@tkmedia.co.za
# Optional: default Reply-To for system emails.
EMAIL_REPLY_TO=
# Optional: route every outgoing email here while testing (includes invites).
RESEND_OVERRIDE_RECIPIENT=

# Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL (custom domain such as https://media.tkmedia.co.za,
# or the *.r2.dev development URL). No trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Browser-direct R2 uploads are enabled by default when R2 is configured
# (bypasses Vercel's 4.5MB server request limit). Requires bucket CORS.
# Set to false to opt out and proxy uploads through the server instead.
R2_CLIENT_UPLOADS=true

# Legacy Supabase (only needed for auth + running the one-off content export)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
