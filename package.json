{
  "name": "tkphotos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "generate-favicons": "node scripts/generate-favicons.cjs",
    "payload": "node --env-file-if-exists=.env.local node_modules/payload/bin.js --use-swc",
    "generate:types": "node --env-file-if-exists=.env.local node_modules/payload/bin.js generate:types --use-swc",
    "generate:importmap": "cross-env R2_CLIENT_UPLOADS=true node --env-file-if-exists=.env.local node_modules/payload/bin.js generate:importmap --use-swc",
    "migrate": "node --env-file-if-exists=.env.local node_modules/payload/bin.js migrate --use-swc",
    "migrate:create": "node --env-file-if-exists=.env.local node_modules/payload/bin.js migrate:create --use-swc",
    "migrate:status": "node --env-file-if-exists=.env.local node_modules/payload/bin.js migrate:status --use-swc",
    "migrate:data:export": "node --env-file-if-exists=.env.local --import @swc-node/register/esm-register scripts/migrate/export-supabase.ts",
    "migrate:data:import": "node --env-file-if-exists=.env.local --import @swc-node/register/esm-register scripts/migrate/import-content.ts",
    "seed:services": "node --env-file-if-exists=.env.local --import @swc-node/register/esm-register scripts/seed-services.ts",
    "email:dev": "email dev --dir ./emails --port 3001",
    "email:test": "node --env-file-if-exists=.env.local --import @swc-node/register/esm-register scripts/email/send-test.tsx"
  },
